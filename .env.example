# VagaVision — variáveis de ambiente
#
# Copie este arquivo para .env na raiz do projeto e preencha os valores.
# O .env NÃO vai para o Git (está no .gitignore). Nunca comite credenciais.
#
#     cp .env.example .env
#
# Quem lê este arquivo: o backend (backend/src/env.js) e o detector (visao/publicar_api.py).

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# Connection string do cluster: Atlas > Database > Connect > Drivers > Node.js.
# Troque <db_password> pela senha do usuário do banco (Atlas > Database Access).
# Se a senha tiver @ : / ? # & %, ela precisa de URL-encode.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nome do banco. Não precisa criar no Atlas: é criado na primeira gravação.
MONGODB_DB=vagavision

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Porta da API (http://localhost:3000/api).
PORT=3000

# Origens liberadas no CORS, separadas por vírgula.
# Vazio = libera qualquer origem, o que é o mais prático em desenvolvimento
# (o `flutter run -d chrome` sorteia uma porta nova a cada execução).
# Em produção, liste os endereços de verdade: https://vagavision-13295.web.app
CORS_ORIGINS=

# Chave da conta de serviço do Firebase, usada para validar o login de quem chama a API.
# Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada.
# Caminho relativo à raiz do projeto ou absoluto. Padrão: visao/firebase-chave.json
FIREBASE_SERVICE_ACCOUNT=visao/firebase-chave.json

# ---------------------------------------------------------------------------
# Detector de visão computacional (visao/)
# ---------------------------------------------------------------------------
# Segredo combinado entre o backend e o detector: é o que autoriza o detector a
# gravar o status das vagas (header X-Detector-Token). Gere qualquer texto longo, ex.:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DETECTOR_TOKEN=troque-por-um-segredo-longo

# Endereço da API que o detector vai chamar.
# No mesmo computador do backend, localhost serve.
VAGAVISION_API=http://localhost:3000/api

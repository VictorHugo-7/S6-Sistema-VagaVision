rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil do usuário (lib/auth_service.dart) — é a única coleção que o app usa no
    // Firestore. Carros, registros de estacionamento e ocupação das vagas ficam no
    // MongoDB, pela API em backend/.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só contas Microsoft institucionais (@maua.br).
    function contaMaua() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@maua[.]br$');
    }

    // Cada usuário só lê/escreve o próprio documento.
    match /usuarios/{uid} {
      allow read, write: if contaMaua() && request.auth.uid == uid;
    }
  }
}

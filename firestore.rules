rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só lê/escreve o próprio documento.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ocupação das vagas detectada pela câmera (visao/detectar_ocupacao.py --firebase).
    // Qualquer usuário logado lê; só o detector grava (a conta de serviço ignora estas regras).
    match /ocupacao/{nivel} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
